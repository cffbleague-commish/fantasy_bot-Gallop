# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_server_id_here
TEAM_LIST_CHANNEL_ID=your_channel_id_here
AWARDS_CHANNEL_ID=your_awards_channel_id_here
COMMITTEE_CHANNEL_ID=your_committee_channel_id_here
RANKINGS_CHANNEL_ID=your_rankings_channel_id_here
GAMEDAY_CHANNEL_ID=your_gameday_channel_id_here
SCHEDULING_CHANNEL_ID=your_scheduling_channel_id_here

# Conference Channel IDs (for draft announcements)
# Set individual conference channels, or just DRAFT_CHANNEL_ID as a fallback
ACC_CHANNEL_ID=your_acc_channel_id_here
B10_CHANNEL_ID=your_b10_channel_id_here
B12_CHANNEL_ID=your_b12_channel_id_here
SEC_CHANNEL_ID=your_sec_channel_id_here
P12_CHANNEL_ID=your_p12_channel_id_here
AAC_CHANNEL_ID=your_aac_channel_id_here
DRAFT_CHANNEL_ID=your_draft_channel_id_here

# Devy Channel IDs (devy commands are restricted to these channels)
# If not set, devy commands can be run from any channel
ACC_DEVY_CHANNEL_ID=your_acc_devy_channel_id_here
B10_DEVY_CHANNEL_ID=your_b10_devy_channel_id_here
B12_DEVY_CHANNEL_ID=your_b12_devy_channel_id_here
SEC_DEVY_CHANNEL_ID=your_sec_devy_channel_id_here
P12_DEVY_CHANNEL_ID=your_p12_devy_channel_id_here
AAC_DEVY_CHANNEL_ID=your_aac_devy_channel_id_here

# Google Sheets Configuration
SERVICE_ACCOUNT_FILE=your_service_account_file.json
LEAGUE_SHEET_ID=your_league_sheet_id_here
SCHEDULER_SHEET_ID=your_scheduler_sheet_id_here
DEVY_SHEET_ID=your_devy_sheet_id_here

# Role Configuration
COMMISSIONER_ROLE_NAME=Commish

# Award Emojis (use Discord custom emoji format: <:name:id> or standard Unicode emoji)
# To get custom emoji ID: type \:emoji_name: in Discord and send the message
EMOJI_HEISMAN=<:HEISMAN:your_emoji_id_here>
EMOJI_NATIONAL_QB=<:OBRIEN:your_emoji_id_here>
EMOJI_NATIONAL_RB=<:WALKER:your_emoji_id_here>
EMOJI_NATIONAL_WR_TE=<:BILETNIKOFF:your_emoji_id_here>
EMOJI_ALL_CONFERENCE=⭐
EMOJI_FIRST_TEAM=🥇
EMOJI_SECOND_TEAM=🥈
EMOJI_THIRD_TEAM=🥉

# Conference Emojis (for All-Conference awards)
EMOJI_CONF_ACC=<:ACC:your_emoji_id_here>
EMOJI_CONF_B10=<:B1G:your_emoji_id_here>
EMOJI_CONF_B12=<:B12:your_emoji_id_here>
EMOJI_CONF_SEC=<:SEC:your_emoji_id_here>
EMOJI_CONF_P12=<:P12:your_emoji_id_here>
EMOJI_CONF_AAC=<:AAC:your_emoji_id_here>

# NFL Draft Emoji
EMOJI_NFL_DRAFT=<:NFLDraft:your_emoji_id_here>

# MyFantasyLeague API Configuration
MFL_LEAGUE_ID=your_league_id_here
MFL_API_KEY=your_mfl_api_key_here
LEAGUE_YEAR=2025
MFL_CURRENT_YEAR=2025
